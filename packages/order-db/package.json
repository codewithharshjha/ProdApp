{
  "name": "@repo/order-db",
  "version": "1.0.0",
  "type": "module",
   "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc --module NodeNext --moduleResolution NodeNext --target ES2022 --outDir dist --rootDir src --declaration --declarationMap --esModuleInterop --strict --skipLibCheck src/index.ts",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "prisma": "^6.19.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.0.3"
  }
}
